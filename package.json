{
  "name": "playstore-rank-tracker",
  "version": "1.0.0",
  "description": "Google Play game ranking tracker: web dashboard + admin panel and a separate scraper worker.",
  "main": "dist/web.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:web": "node dist/web.js",
    "start:scraper": "node dist/scraper.js",
    "dev:web": "tsx watch src/web.ts",
    "dev:scraper": "tsx watch src/scraper.ts",
    "scrape:now": "tsx src/enqueue.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "google-play-scraper",
    "node-cron",
    "postgresql",
    "sequelize",
    "typescript",
    "telegram-bot",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "google-play-scraper": "^10.1.2",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
