[Unit]
Description=Play Store Rank Tracker - web dashboard and admin
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/playstore-tracker
EnvironmentFile=/opt/playstore-tracker/.env
Environment=NODE_ENV=production NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node dist/web.js
Restart=always
RestartSec=5s
MemoryMax=400M
User=tracker
SyslogIdentifier=playstore-web

[Install]
WantedBy=multi-user.target
